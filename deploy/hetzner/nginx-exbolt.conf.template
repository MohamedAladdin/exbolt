# =============================================================================
# ExBolt — nginx site for the Next.js app behind Let's Encrypt
# =============================================================================
#
# This is a TEMPLATE. Two placeholders must be substituted before use:
#
#   __DOMAIN__    public hostname, e.g. crm.example.com   (no scheme, no slash)
#   __UPSTREAM__  where the app container listens, default 127.0.0.1:3000
#
# Render (as root, after DNS points at the host):
#
#   DOMAIN=crm.example.com
#   UPSTREAM=127.0.0.1:3000
#   sed -e "s|__DOMAIN__|${DOMAIN}|g" -e "s|__UPSTREAM__|${UPSTREAM}|g" \
#       nginx-exbolt.conf.template \
#     > /etc/nginx/sites-available/exbolt.conf
#   ln -sfn /etc/nginx/sites-available/exbolt.conf /etc/nginx/sites-enabled/exbolt.conf
#   rm -f /etc/nginx/sites-enabled/default
#   nginx -t && systemctl reload nginx
#
# The certificate must exist before the TLS server block will load — see
# README.md ("DNS + TLS") for the `certbot certonly --webroot` step that runs
# first, against a throwaway ACME-only server block.
#
# META WEBHOOK
#   Meta must be able to reach the app over public HTTPS at
#     https://__DOMAIN__/api/whatsapp/webhook
#   That URL is registered in Meta for Developers → WhatsApp/Messenger →
#   Configuration → Callback URL, together with the verify token
#   (META_WEBHOOK_VERIFY_TOKEN). Meta calls it with GET (subscription
#   handshake) and POST (events), so it must NOT be behind basic auth, IP
#   allow-listing, or a redirect. Plain HTTP is redirected to HTTPS below,
#   which Meta follows — but register the https:// URL directly anyway.
# =============================================================================

# WebSocket / SSE upgrade helper. `map` must live in the http context; nginx
# includes sites-enabled/*.conf inside `http { }`, so defining it here is valid
# and keeps this site self-contained.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# -----------------------------------------------------------------------------
# :80 — ACME challenges + permanent redirect to HTTPS
# -----------------------------------------------------------------------------
server {
    listen      80;
    listen      [::]:80;
    server_name __DOMAIN__;

    # certbot --webroot writes its challenge files here.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    # Everything else goes to HTTPS. $host keeps the request hostname so a
    # second hostname (e.g. www.) does not get redirected to the wrong name.
    location / {
        return 301 https://$host$request_uri;
    }
}

# -----------------------------------------------------------------------------
# :443 — the app
# -----------------------------------------------------------------------------
server {
    # nginx < 1.25.1: keep the `http2` parameter on `listen`.
    # nginx >= 1.25.1: drop it and use `http2 on;` instead (the parameter is
    # deprecated there and logs a warning). Ubuntu 24.04 ships 1.24.
    listen      443 ssl http2;
    listen      [::]:443 ssl http2;
    server_name __DOMAIN__;

    # --- TLS -----------------------------------------------------------------
    # Paths are the ones certbot creates for this lineage. `certbot --nginx`
    # would rewrite these lines; we manage them explicitly so renewals only
    # need `systemctl reload nginx` (see the deploy hook in README.md).
    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout       1d;
    ssl_session_cache         shared:ExBolt_tls:10m;
    ssl_session_tickets       off;

    # HSTS is emitted by the app itself (next.config.ts security headers).
    # Do not duplicate it here.

    # --- compression ---------------------------------------------------------
    gzip              on;
    gzip_vary         on;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        application/xml
        application/xml+rss
        application/rss+xml
        application/atom+xml
        image/svg+xml;

    # --- request body --------------------------------------------------------
    # Inbound WhatsApp media (images, documents, voice notes) is fetched by the
    # app from Meta, but operators also upload branding assets and AI knowledge
    # files through the UI. Meta caps media at 16 MB; 25 MB leaves headroom for
    # multipart overhead without inviting abuse.
    client_max_body_size 25m;
    client_body_timeout  60s;

    server_tokens off;

    # Proxy defaults, inherited by every location below.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    proxy_connect_timeout 10s;
    proxy_send_timeout    300s;
    # AI replies and bulk broadcast replies can take a while; 300s matches
    # proxy_send_timeout so the app, not nginx, decides when to give up.
    proxy_read_timeout    300s;

    # Deliberately NOT overriding Cache-Control for / or /_next/static:
    # next.config.ts sets `private, no-store` on HTML and Next emits immutable
    # headers for hashed assets. nginx `expires` rules here have previously
    # caused stale HTML referencing deleted chunks.

    # --- Meta webhook --------------------------------------------------------
    # Must stay public and unauthenticated. Meta retries failed deliveries, so
    # fail fast (rather than queueing at nginx) and let the app's HMAC
    # verification (META_APP_SECRET) be the gate.
    location = /api/whatsapp/webhook {
        proxy_pass http://__UPSTREAM__;
        proxy_read_timeout 30s;
        proxy_buffering    off;
    }

    # --- app -----------------------------------------------------------------
    location / {
        proxy_pass http://__UPSTREAM__;
    }

    # Health endpoint used by Docker/compose and by operator checks.
    location = /login {
        proxy_pass http://__UPSTREAM__;
        access_log off;
    }
}
